# Valkey/Redis Configuration
VALKEY_URL=redis://localhost:6379/0

# For production with authentication:
# VALKEY_URL=redis://username:password@valkey-host:6379/0
# For TLS/SSL:
# VALKEY_URL=rediss://username:password@valkey-host:6380/0

# Email Service Configuration (uncomment as needed)
# AWS_SES_REGION=us-east-1
# AWS_SES_ACCESS_KEY=your_access_key
# AWS_SES_SECRET_KEY=your_secret_key
# SENDGRID_API_KEY=your_sendgrid_api_key
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_username
# SMTP_PASSWORD=your_password

# SMS Service Configuration (uncomment as needed)
# AWS_SNS_REGION=us-east-1
# AWS_SNS_ACCESS_KEY=your_access_key
# AWS_SNS_SECRET_KEY=your_secret_key
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Push Notification Configuration (uncomment as needed)
# FCM_SERVER_KEY=your_firebase_server_key
# APNS_KEY_ID=your_apple_key_id
# APNS_TEAM_ID=your_apple_team_id
# APNS_BUNDLE_ID=com.yourapp.bundle
# EXPO_ACCESS_TOKEN=your_expo_access_token

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
